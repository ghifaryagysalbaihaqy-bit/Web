APP_NAME=CloudVault
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ==========================================
# DATABASE CONFIGURATION (PRODUCTION)
# ==========================================
# For SQLite (default development):
# DB_CONNECTION=sqlite

# For MySQL / MariaDB (Recommended for standard Production):
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cloudvault_db
DB_USERNAME=cloudvault_user
DB_PASSWORD=your_strong_password_here

# For PostgreSQL (Alternative Production):
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=cloudvault_db
# DB_USERNAME=cloudvault_user
# DB_PASSWORD=your_strong_password_here

# ==========================================
# SESSION, CACHE & QUEUE
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

# For Redis (High Performance Caching & Queues):
# REDIS_CLIENT=phpredis
# REDIS_HOST=127.0.0.1
# REDIS_PASSWORD=null
# REDIS_PORT=6379

# ==========================================
# MAIL / SMTP CONFIGURATION
# ==========================================
# Configure your SMTP provider (Gmail, Mailgun, Brevo, Resend, etc.)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# STORAGE CONFIGURATION (LOCAL OR S3/R2)
# ==========================================
# Local Persistent Disk:
FILESYSTEM_DISK=local

# Cloud Object Storage (AWS S3, Cloudflare R2, MinIO, Wasabi):
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=cloudvault-storage
# AWS_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ==========================================
# UPLOAD LIMIT RECOMMENDATIONS (php.ini & Nginx)
# ==========================================
# For handling large file uploads (e.g. 756MB, 1GB, up to 2GB):
# upload_max_filesize = 2048M
# post_max_size = 2100M
# memory_limit = 512M
# max_execution_time = 600
# max_input_time = 600
# Nginx: client_max_body_size 2048M;

VITE_APP_NAME="${APP_NAME}"
